{
    "name": "damoon/schema",
    "description": "schema.org JSON-LD for Laravel models, with a Filament editor that fills each record's defaults by itself.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Damoon\\Schema\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Damoon\\Schema\\SchemaServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
